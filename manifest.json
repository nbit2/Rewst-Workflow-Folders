{
  "manifest_version": 3,
  "name": "Rewst Workflow Folders",
  "version": "1.0.0",
  "description": "Adds folder organisation to the Rewst workflows list",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://app.rewst.io/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d2f9864c-fb4b-4a4c-8480-b71540997968}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rewst Workflow Folders"
  },
  "content_scripts": [
    {
      "matches": ["https://app.rewst.io/organizations/*/workflows*"],
      "js": ["storage.js", "rows.js", "contextmenu.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}